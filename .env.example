# Copy this file to .env for local development.
# Generate a unique random value for SECRET_KEY; never commit the real .env file.
SECRET_KEY=replace_with_a_long_random_secret
ADMIN_USERNAME=saloni
ADMIN_PASSWORD=replace_with_a_unique_strong_password
# Optional: use PostgreSQL instead of the local SQLite database.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
# Optional: set to 1 only when serving the site over HTTPS.
COOKIE_SECURE=0
